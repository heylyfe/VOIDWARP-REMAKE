# engine binary is fetched, never committed
tools/godot/*
!tools/godot/VERSION.txt
!tools/godot/README.md
__pycache__/
*.pyc
.godot/
build/
terrain_ref/out/
out/

# Godot 4 script/resource UID sidecars (regenerated on import)
*.uid

# portable Blender (FLEET_PACK section 3: gitignored, installed under the main checkout per R19)
tools/blender/*
!tools/blender/VERSION.txt
# screenshot sidecars: the shots are re-rendered evidence, not imported game assets
game/shots/*.import

# PNG import sidecars: regenerated by the gate's --import step, same reason as *.uid above.
# The 11 tracked .glb.import files from T-015 stay tracked (they predate this rule).
*.png.import

# WAV import sidecars: T-055's synthesized placeholder cues get the same treatment.
*.wav.import

# gate and run logs: local evidence, never committed
*.log

# Secrets and credentials: never commit these, ever. Nothing tracked matches these rules today
# (verified with git ls-files); they exist so a future .env or key cannot be swept in by git add -A.
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials*.json
secrets/

# Compiled binaries. The export lives in build/ (already ignored above); a stray one anywhere else
# is not wanted either. Nothing tracked matches these rules today.
*.exe
*.dll
*.so
*.dylib
*.pdb

# Third-party character images supplied for the enemy art pass. Kept locally as the source of
# game/tools/art/*.gd (the derived sprites under game/content are what the game ships); they are not
# ours to redistribute, so they are not tracked. assets_src/enemies/README.md stays.
assets_src/enemies/*
!assets_src/enemies/README.md

# The guardian's own working log. It records absolute paths from the machine it runs on, so it is
# kept locally and never published. It was tracked by mistake; untracked in cycle 2 after a
# fresh-eyes review found a home-directory path in it.
GUARDIAN.md

# B10 collapse screenshot pass output (tests/shot_collapse.gd): re-rendered evidence, not assets
shots_b10/
