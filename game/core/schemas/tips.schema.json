{
  "$comment": "data/tips.json schema (DESIGN.md section 14; ticket T-013). The loading screen weights hazard_tell tips x3 (T-014c convention; see D-T014c-2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["tips"],
  "properties": {
    "_doc": {"type": "string"},
    "tips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "tags", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "text": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "source": {"type": "string"}
        }
      }
    }
  }
}
