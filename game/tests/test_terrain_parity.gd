extends SceneTree

# Headless parity test against the Python oracle:
#   tools\godot\godot.exe --headless --path game --script res://tests/test_terrain_parity.gd -- "<abs path to terrain_ref/gallery.json>"
#
# 1. Checks every record in gallery.json (players=1, extra_mines=0) and prints OK/DIFF per record.
#    NOTE: if terrain_ref/voidgen.py was edited after gallery.json was last regenerated, the pinned
#    hashes are stale; the live oracle wins (see GALLERY_PIN line and the port report).
# 2. Checks every record in res://tests/parity_cases.json (generated by game/tools/make_parity_cases.py
#    from the LIVE voidgen.py; includes the gallery (seed, level) pairs with fresh live hashes).
# 3. Prints total generation milliseconds, then final line "PARITY n/n OK" (exit 0) or
#    "PARITY n/n FAIL" (exit 1) over the live-oracle cases.

const VoidGenScript := preload("res://terrain/voidgen.gd")

var matched: int = 0
var total: int = 0
var gen_ms: int = 0
var pin_matched: int = 0
var pin_total: int = 0


func _init() -> void:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	if args.size() < 1:
		print("USAGE: test_terrain_parity.gd -- <path/to/gallery.json>")
		quit(1)
		return
	var gallery_path: String = args[0]
	var f := FileAccess.open(gallery_path, FileAccess.READ)
	if f == null:
		print("CANNOT_OPEN %s" % gallery_path)
		quit(1)
		return
	var recs: Variant = JSON.parse_string(f.get_as_text())
	f.close()
	if recs == null or typeof(recs) != TYPE_ARRAY:
		print("GALLERY_PARSE_FAILED")
		quit(1)
		return
	for rec in recs:
		var sd: int = int(rec["seed"])
		var lv: int = int(rec["level"])
		pin_total += 1
		var t0: int = Time.get_ticks_msec()
		var L: Dictionary = VoidGenScript.generate(sd, lv, 1, 0)
		gen_ms += Time.get_ticks_msec() - t0
		var got: String = VoidGenScript.level_hash(L) if not L.is_empty() else "GEN_FAILED"
		if got == str(rec["hash"]):
			pin_matched += 1
			print("OK seed=%d level=%d" % [sd, lv])
		else:
			print("DIFF seed=%d level=%d expected=%s got=%s" % [sd, lv, rec["hash"], got])

	var f2 := FileAccess.open("res://tests/parity_cases.json", FileAccess.READ)
	if f2 == null:
		print("CANNOT_OPEN res://tests/parity_cases.json (run game/tools/make_parity_cases.py first)")
		print("PARITY %d/%d FAIL" % [matched, total])
		quit(1)
		return
	var recs2: Variant = JSON.parse_string(f2.get_as_text())
	f2.close()
	for rec in recs2:
		check_one(int(rec["seed"]), int(rec["level"]), int(rec["players"]), int(rec["extra_mines"]), str(rec["hash"]))

	if total > 0:
		print("gen total=%d ms mean=%.2f ms/level" % [gen_ms, float(gen_ms) / float(total)])
	print("GALLERY_PIN %d/%d pinned-gallery records match (stale pins are listed as DIFF above; live voidgen.py is the oracle)" % [pin_matched, pin_total])
	if matched == total:
		print("PARITY %d/%d OK" % [matched, total])
		quit(0)
	else:
		print("PARITY %d/%d FAIL" % [matched, total])
		quit(1)


func check_one(sd: int, lv: int, players: int, extra: int, expected: String) -> void:
	total += 1
	var t0: int = Time.get_ticks_msec()
	var L: Dictionary = VoidGenScript.generate(sd, lv, players, extra)
	gen_ms += Time.get_ticks_msec() - t0
	var got: String = VoidGenScript.level_hash(L) if not L.is_empty() else "GEN_FAILED"
	if got == expected:
		matched += 1
		print("OK seed=%d level=%d players=%d extra=%d" % [sd, lv, players, extra])
	else:
		print("DIFF seed=%d level=%d players=%d extra=%d expected=%s got=%s" % [sd, lv, players, extra, expected, got])
