extends SceneTree
#
# upgrade_table.gd - the README upgrade table, generated from the data (cycle 4 item 15,
# D-C4-15-3). The table cannot drift: tests/test_upgrade_tiers.gd regenerates it with
# table_markdown() and fails when README.md's block differs by one byte.
#
#   <godot> --headless --path game --script res://tools/upgrade_table.gd            (print)
#   <godot> --headless --path game --script res://tools/upgrade_table.gd -- --write (README)
#
# Every number is read, never typed: tier / price / max stacks from content/upgrades/*.json,
# the bands and pool-from levels from data/upgrade_pools.json "tiers", "pool from" from
# core/content_api.gd shop_pool() (the brackets AND the tier gate, the same call the shop
# makes), "first shop" from sim/intermission.gd bays_for_level() (the first level at or
# after "pool from" whose lobby has a U or REST bay - the first time a player can see it).
# Levels are "the level just completed": the shop after level 4 is "4".

const ContentApiScript := preload("res://core/content_api.gd")
const IntermissionScript := preload("res://sim/intermission.gd")
const OffersScript := preload("res://sim/offers.gd")

const BEGIN := "<!-- upgrade-table:begin (generated by game/tools/upgrade_table.gd - do not edit by hand) -->"
const END := "<!-- upgrade-table:end -->"
const SCAN_TO := 60          # levels scanned for pool entry / first shop (T5 enters at 26)
const TIER_ORDER: Array[String] = ["T1", "T2", "T3", "T4", "T5"]


func _init() -> void:
	var api: RefCounted = ContentApiScript.load()
	if not api.is_ok():
		print("UPGRADE_TABLE FAIL (content boot refused: %s)" % " / ".join(api.boot_errors()))
		quit(1)
		return
	var md := table_markdown(api)
	if not OS.get_cmdline_user_args().has("--write"):
		print(md)
		quit(0)
		return
	var path := readme_path()
	var text := FileAccess.get_file_as_string(path)
	var a := text.find(BEGIN)
	var b := text.find(END)
	if a < 0 or b < a:
		print("UPGRADE_TABLE FAIL (markers not found in %s)" % path)
		quit(1)
		return
	var out := text.substr(0, a) + md + text.substr(b + END.length())
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(out)
	f.close()
	print("UPGRADE_TABLE OK (wrote %s)" % path)
	quit(0)


## The repo README (one level above the Godot project).
static func readme_path() -> String:
	return ProjectSettings.globalize_path("res://").path_join("../README.md").simplify_path()


## First level in 0..SCAN_TO whose shop pool holds p_id, or -1.
static func pool_from(p_api: RefCounted, p_id: String) -> int:
	for lv in range(0, SCAN_TO + 1):
		if p_api.shop_pool(lv).has(p_id):
			return lv
	return -1


## First level >= pool_from whose lobby has a shop (U or REST) and whose pool holds p_id.
static func first_shop(p_api: RefCounted, p_id: String) -> int:
	for lv in range(0, SCAN_TO + 1):
		if not p_api.shop_pool(lv).has(p_id):
			continue
		for bay in IntermissionScript.bays_for_level(p_api, lv):
			var k := str((bay as Dictionary).get("bay", ""))
			if k == "U" or k == "REST":
				return lv
	return -1


## The whole generated block, markers included, ending in a newline.
static func table_markdown(p_api: RefCounted) -> String:
	var tiers: Dictionary = p_api.tiers()
	var lines: Array[String] = [BEGIN, ""]
	lines.append("| tier | list price band | in the pool from level |")
	lines.append("|---|---|---|")
	for t in TIER_ORDER:
		var row: Dictionary = tiers.get(t, {})
		lines.append("| %s | %d-%d g | %d |" % [t, int(row.get("price_min", 0)),
				int(row.get("price_max", 0)), int(row.get("pool_from", 0))])
	lines.append("")
	lines.append("| upgrade | tier | price | 2nd stack | 3rd stack | max stacks | pool from | first shop | class |")
	lines.append("|---|---|---|---|---|---|---|---|---|")
	var rows: Array = []
	for id in p_api.upgrade_ids():
		var u: Dictionary = p_api.upgrade(id)
		rows.append([TIER_ORDER.find(str(u.get("tier", ""))), int(u.get("price", 0)), str(id), u])
	rows.sort_custom(func(x, y): return x[0] < y[0] or (x[0] == y[0] and (x[1] < y[1] or (x[1] == y[1] and str(x[2]) < str(y[2])))))
	for r in rows:
		var id := str(r[2])
		var u: Dictionary = r[3]
		var st := int(u.get("max_stacks", 1))
		var s2 := str(OffersScript.price_for(u, 1)) if st >= 2 else "-"
		var s3 := str(OffersScript.price_for(u, 2)) if st >= 3 else "-"
		var only: Variant = u.get("class_only")
		var cls := str(only) + " only" if only != null and str(only) != "" else "all"
		var pf := pool_from(p_api, id)
		var fs := first_shop(p_api, id)
		lines.append("| %s | %s | %d | %s | %s | %d | %s | %s | %s |" % [
				str(u.get("name", id)), str(u.get("tier", "")), int(u.get("price", 0)), s2, s3, st,
				str(pf) if pf >= 0 else "never", str(fs) if fs >= 0 else "never", cls])
	lines.append("")
	lines.append(END)
	return "\n".join(lines) + "\n"
