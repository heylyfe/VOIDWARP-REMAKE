extends RefCounted
#
# The one lookup the views use for curse and upgrade icon art (TBD.md row 21).
#
#   texture_for("upgrades", "brace")  -> Texture2D, or null when there is no art
#   has_art("curses", "brittle")      -> bool
#
# The art is generated by game/tools/art/icons.gd into assets/icons/<kind>/<id>.png, one
# PNG per content id. A missing file returns null and the caller falls back to
# view/hud/icon_placeholder.gd: a missing icon must never crash or stall the run (the
# house rule), so nothing here asserts, pushes an error, or blocks.
#
# Textures are cached per path. The HUD rebuilds its rows whenever the owned set changes
# and the Antechamber rebuilds its altars on every lobby stamp, so a load() per cell would
# re-read the same PNG dozens of times a second.
#
# Layer rules (game/tests/test_boundaries.gd): view/ may use everything; this file names
# no content id, only the two kind folders.

const DIRS := {
	"upgrades": "res://assets/icons/upgrades/",
	"curses": "res://assets/icons/curses/",
}

static var _cache: Dictionary = {}


## The res:// path for one icon, or "" when the kind is unknown or the id is empty.
static func path_for(kind: String, id: String) -> String:
	var dir: String = str(DIRS.get(kind, ""))
	if dir == "" or id == "":
		return ""
	return dir + id + ".png"


## The icon texture, or null when this id has no art yet (the caller draws the placeholder).
static func texture_for(kind: String, id: String) -> Texture2D:
	var path := path_for(kind, id)
	if path == "":
		return null
	if _cache.has(path):
		return _cache[path]
	var tex: Texture2D = null
	if ResourceLoader.exists(path):
		tex = load(path) as Texture2D
	_cache[path] = tex
	return tex


static func has_art(kind: String, id: String) -> bool:
	return texture_for(kind, id) != null


## Test seam: drop the cache so a test can re-read the files from disk.
static func clear_cache() -> void:
	_cache.clear()
